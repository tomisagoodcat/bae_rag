 
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix chebi: <http://purl.obolibrary.org/obo/CHEBI_> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix deo: <http://purl.org/spar/deo/> .
@prefix envo: <http://purl.obolibrary.org/obo/ENVO_> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix gn: <http://www.geonames.org/ontology#> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix mp: <http://purl.org/mp#> .
@prefix ncbitaxon: <http://purl.obolibrary.org/obo/NCBITaxon_> .
@prefix obi: <http://purl.obolibrary.org/obo/obi#> .
@prefix omath: <http://ontomathpro.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ro: <http://purl.obolibrary.org/obo/RO_> .
@prefix rrdfs: <> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stato: <http://purl.obolibrary.org/obo/STATO_> .
@prefix uo: <http://purl.obolibrary.org/obo/UO_> .
@prefix whu: <http://example.org/whu#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

################################################### 
### 基于deo，dc对文章的基本结构，元数据进行定义，提供初始的识别节点
#########################################################
#################################################################
# Class: whu:NatureSciencePublication
#################################################################

whu:NatureSciencePublication a owl:Class ;
    rdfs:label "Natural Science Publication"@en ;
    rdfs:comment "A journal-published experimental report in the domain of natural sciences."@en ;
    rdfs:subClassOf fabio:ExperimentalReport , fabio:JournalArticle ;

    # Must have a title
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty dct:title ;
        owl:someValuesFrom xsd:string ;
        rdfs:comment "The publication must have a title as a textual string."@en ;
        whu:prompt "Extract the title of the publication."@en
    ] ;

    # Must have a creator (author/agent)
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty dct:creator ;
        owl:someValuesFrom foaf:Agent ;
        rdfs:comment "The publication must have one or more creators (e.g. person or organization)."@en ;
        whu:prompt "Identify the creator(s) of the publication."@en
    ] ;

    # Must have a publisher
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty dct:publisher ;
        owl:someValuesFrom foaf:Organization ;
        rdfs:comment "The publication must be published by an organization (e.g., journal or publisher)."@en ;
        whu:prompt "Identify the publisher of the publication."@en
    ] ;

    # Must contain at least one section
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty deo:hasSection ;
        owl:someValuesFrom deo:Section ;
        rdfs:comment "The publication must contain at least one section (e.g., introduction, methods)."@en ;
        whu:prompt "Identify structural sections within the publication."@en
    ] ;

    # Must contain a background evidence module
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ro:has_part ;
        owl:someValuesFrom whu:EvidenceBackground ;
        rdfs:comment "The publication must describe background evidence such as environmental context or setting."@en ;
        whu:prompt "Extract environmental or contextual background information."@en
    ] ;

    # Must include at least one micropublication unit
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty ro:has_part ;
        owl:someValuesFrom mp:Micropublication ;
        rdfs:comment "The publication must include at least one structured micropublication argument unit."@en ;
        whu:prompt "Identify micropublications that express claims and evidence in the article."@en
    ] .