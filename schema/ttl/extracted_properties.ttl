@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix whu: <http://example.org/whu#> .

whu:hasExecutionEnvironment a owl:ObjectProperty ;
    rdfs:label "hasExecutionEnvironment"@en ;
    whu:prompt "Identify the execution environment involved in this step."@en ;
    rdfs:comment "This step involves an execution environment."@en,
        "该步骤涉及实验环境。"@zh ;
    rdfs:domain whu:BioChemicalActivityStep ;
    rdfs:range whu:ExecutionEnvironment .

<http://purl.obolibrary.org/obo/IAO_denotes> a owl:ObjectProperty ;
    rdfs:label "IAO_denotes"@en ;
    rdfs:domain whu:Indicator_definition ;
    rdfs:range <http://ontomathpro.org/ontology/Formula> .

<http://purl.obolibrary.org/obo/IAO_is_about> a owl:ObjectProperty ;
    rdfs:label "IAO_is_about"@en ;
    whu:prompt "Extract or specify the quantity, volume, or mass of the specimen using QUDT units."@en ;
    rdfs:comment "the dataSet about speciemen for example how many specimen has been collected."@en,
        "与样本相关信息，比如样本的数量、体积、质量等。"@zh ;
    rdfs:domain whu:ProcessedSpecimen,
        whu:Specimen,
        whu:Target_analyte ;
    rdfs:range whu:DataSet,
        whu:Method .

<http://purl.obolibrary.org/obo/IAO_is_denoted_by> a owl:ObjectProperty ;
    rdfs:label "IAO_is_denoted_by"@en ;
    rdfs:domain whu:Indicator ;
    rdfs:range whu:Indicator_definition .

<http://purl.obolibrary.org/obo/RO_denotes> a owl:ObjectProperty ;
    rdfs:label "RO_denotes"@en ;
    rdfs:domain whu:Target_analyte ;
    rdfs:range <http://purl.org/mp#Data> .

<http://purl.obolibrary.org/obo/RO_has_constituent> a owl:ObjectProperty ;
    rdfs:label "RO_has_constituent"@en ;
    whu:prompt "include chemical pollutants (e.g., Hg, Cr)."@en,
        "include environmental material constituents (soil, water)."@en ;
    rdfs:comment "environmental material constituents (soil, water)."@en,
        "include chemical pollutants (e.g., Hg, Cr)."@en,
        "包含化学污染物（如汞、铬等）。"@zh,
        "包含环境物质组成（如土壤、水等）。"@zh ;
    rdfs:domain whu:EnvironmentFeature ;
    rdfs:range <http://purl.obolibrary.org/obo/CHEBI_24431>,
        <http://purl.obolibrary.org/obo/ENVO_00010483> .

<http://purl.obolibrary.org/obo/RO_has_goal> a owl:ObjectProperty ;
    rdfs:label "RO_has_goal"@en ;
    whu:prompt "This experiment has a specific scientific goal or objective."@en ;
    rdfs:comment "This experiment has a specific scientific goal or objective."@en,
        "这个实验有具体的目标。"@zh ;
    rdfs:domain whu:bio_chemical_Experiment ;
    rdfs:range whu:Goal .

<http://purl.obolibrary.org/obo/RO_has_quality> a owl:ObjectProperty ;
    rdfs:label "RO_has_quality"@en ;
    whu:prompt "the environmental condition (e.g., tropical, polar)."@en ;
    rdfs:comment "the environmental condition (e.g., tropical, polar)."@en,
        "环境状态（如热带、极地等）。"@zh ;
    rdfs:domain whu:EnvironmentFeature ;
    rdfs:range <http://purl.obolibrary.org/obo/ENVO_01000254> .

<http://purl.obolibrary.org/obo/RO_is_target_of> a owl:ObjectProperty ;
    rdfs:label "RO_is_target_of"@en ;
    rdfs:domain whu:Target_analyte ;
    rdfs:range whu:Goal .

<http://purl.obolibrary.org/obo/UO_hasUnit> a owl:ObjectProperty ;
    rdfs:label "UO_hasUnit"@en ;
    whu:prompt "Specify concentration unit as micromolar."@en,
        "Specify volume unit as milliliter."@en ;
    rdfs:comment "Unit for concentration: micromolar."@en,
        "Unit for volume: milliliter."@en,
        "体积单位：毫升。"@zh,
        "浓度单位：微摩尔。"@zh ;
    rdfs:domain whu:Reagent ;
    rdfs:range <http://purl.obolibrary.org/obo/UO_micromolar>,
        <http://purl.obolibrary.org/obo/UO_milliliter> .

<http://purl.obolibrary.org/obo/obi#has_taxonomic_identifier> a owl:ObjectProperty ;
    rdfs:label "has_taxonomic_identifier"@en ;
    whu:prompt "Link the specimen to its biological classification using NCBI Taxon ID."@en ;
    rdfs:comment "Specimen is taxonomically classified using the NCBI Taxonomy ontology (e.g., species, genus, family)."@en,
        "标本通过 NCBI 分类本体进行生物分类标识，例如种、属、科等。"@zh ;
    rdfs:domain whu:Specimen ;
    rdfs:range <http://purl.obolibrary.org/obo/NCBITaxon_0000000> .

<http://purl.org/mp#argues> a owl:ObjectProperty ;
    rdfs:label "argues"@en ;
    whu:prompt "Identify the claim supported by this evidence graph."@en ;
    rdfs:comment "Specifies the claim supported by the evidence graph."@en,
        "指明该证据图所支持的claim。"@zh ;
    rdfs:domain <http://purl.org/mp#Micropublication> ;
    rdfs:range <http://purl.org/mp#Claim> .

<http://purl.org/mp#generates> a owl:ObjectProperty ;
    rdfs:label "generates"@en ;
    whu:prompt "Specify the data generated by this reagent."@en ;
    rdfs:comment "This reagent produced experimental data."@en,
        "该试剂在实验中产生了数据。"@zh ;
    rdfs:domain whu:Reagent ;
    rdfs:range <http://purl.org/mp#Data> .

<http://purl.org/mp#hasSupport> a owl:ObjectProperty ;
    rdfs:label "hasSupport"@en ;
    whu:prompt "Identify the scientific evidence graph elements supported by this evidence graph."@en,
        "Identify the statement supported by this evidence graph."@en ;
    rdfs:comment "Specifies the scientific evidence graph elements supported by the evidence graph."@en,
        "Specifies the statement supported by the evidence graph."@en,
        "指明该证据图所支持的声明。"@zh,
        "指明该证据图所支持的科学证据图元素。"@zh ;
    rdfs:domain <http://purl.org/mp#Micropublication> ;
    rdfs:range whu:ScientificEvidence,
        <http://purl.org/mp#Statement> .

<http://purl.org/net/p-plan#correspondsToStep> a owl:ObjectProperty ;
    rdfs:label "correspondsToStep"@en ;
    whu:prompt "Specify the design step corresponding to this step."@en ;
    rdfs:comment "This step corresponds to a design step."@en,
        "该步骤对应一个设计步骤。"@zh ;
    rdfs:domain whu:BioChemicalActivityStep,
        whu:ComputationalActivityStep ;
    rdfs:range <http://purl.org/net/p-plan#Step> .

<http://purl.org/net/p-plan#has_Plan> a owl:ObjectProperty ;
    rdfs:label "has_Plan"@en ;
    whu:prompt "Specify the biochemical experiment."@en,
        "Specify the computationalcomputational experiment."@en ;
    rdfs:comment "This step is part of a biochemical experiment."@en,
        "This step is part of a computational experiment."@en,
        "该步骤属于生物化学实验。"@zh,
        "该步骤属于计算实验。"@zh ;
    rdfs:domain whu:BioChemicalActivityStep,
        whu:ComputationalActivityStep ;
    rdfs:range whu:bio_chemical_Experiment .

<http://purl.org/net/p-plan#isInputVarOf> a owl:ObjectProperty ;
    rdfs:label "isInputVarOf"@en ;
    whu:prompt "Identify the biochemical experiment that used this processed specimen as input."@en,
        "Identify the specimen preprocessing activity that used this specimen as input."@en ;
    rdfs:comment "This specimen is used as an input variable in a specimen preprocessing plan, such as filtering, centrifugation, or staining."@en,
        "This specimen is used as input in a biochemical experiment."@en,
        "该标本作为输入用于生化实验中。"@zh,
        "该标本是样本预处理计划的输入变量，例如过滤、离心、染色等实验处理流程的输入。"@zh ;
    rdfs:domain whu:ProcessedSpecimen,
        whu:Specimen ;
    rdfs:range whu:SpecimenPreprocessing,
        whu:bio_chemical_Experiment .

<http://purl.org/net/p-plan#isOutputVarOf> a owl:ObjectProperty ;
    rdfs:label "isOutputVarOf"@en ;
    whu:prompt "Identify the specimen collection activity that produced this specimen."@en,
        "Specify the specimen preprocessing plan that generated this processed specimen."@en ;
    rdfs:comment "The processed specimen is the output of a specimen preprocessing step."@en,
        "This specimen is the output variable of a specimen collection plan, indicating its generation through structured sampling."@en,
        "该标本是样本采集计划的输出变量，表示其通过结构化采样过程产生。"@zh,
        "该标本是样本预处理流程的输出产物。"@zh ;
    rdfs:domain whu:ProcessedSpecimen,
        whu:Specimen ;
    rdfs:range whu:SpecimenCollection,
        whu:SpecimenPreprocessing .

<http://purl.org/net/p-plan#isPreceededBy> a owl:ObjectProperty ;
    rdfs:label "isPreceededBy"@en ;
    whu:prompt "Indicate the specimen preprocessing plan that precedes this collection plan."@en ;
    rdfs:comment "This collection plan follows a specimen preprocessing plan in the experimental sequence."@en,
        "该采集计划在实验顺序中位于预处理计划之后。"@zh ;
    rdfs:domain whu:SpecimenCollection ;
    rdfs:range whu:SpecimenPreprocessing .

<http://purl.org/net/p-plan#ispreceededBy> a owl:ObjectProperty ;
    rdfs:label "ispreceededBy"@en ;
    whu:prompt "just like material_processing, but with a specific focus on specimen preprocessing."@en ;
    rdfs:comment "just like material_processing, but with a specific focus on specimen preprocessing."@zh ;
    rdfs:domain whu:SpecimenPreprocessing ;
    rdfs:range whu:bio_chemical_Experiment .

<http://purl.org/spar/fabio/hasFigure> a owl:ObjectProperty ;
    rdfs:label "hasFigure"@en ;
    whu:prompt "Identify the figure included in this step."@en ;
    rdfs:comment "This step includes a figure."@en,
        "该步骤包含图形。"@zh ;
    rdfs:domain whu:BioChemicalActivityStep,
        whu:ComputationalActivityStep ;
    rdfs:range <http://purl.org/spar/fabio/Figure> .

<http://purl.org/spar/fabio/hasTable> a owl:ObjectProperty ;
    rdfs:label "hasTable"@en ;
    whu:prompt "Identify the table included in this step."@en ;
    rdfs:comment "This step includes a table."@en,
        "该步骤包含表格。"@zh ;
    rdfs:domain whu:BioChemicalActivityStep,
        whu:ComputationalActivityStep ;
    rdfs:range <http://purl.org/spar/fabio/Table> .

<http://qudt.org/schema/qudt/hasConcentration> a owl:ObjectProperty ;
    rdfs:label "hasConcentration"@en ;
    whu:prompt "Extract the concentration of the reagent."@en ;
    rdfs:comment "Specifies the concentration of the reagent."@en,
        "指定试剂的浓度。"@zh ;
    rdfs:domain whu:Reagent ;
    rdfs:range <http://qudt.org/schema/qudt/QuantityValue> .

<http://qudt.org/schema/qudt/hasVolume> a owl:ObjectProperty ;
    rdfs:label "hasVolume"@en ;
    whu:prompt "Extract the volume of the reagent."@en ;
    rdfs:comment "Specifies the volume of the reagent used."@en,
        "指定使用的试剂体积。"@zh ;
    rdfs:domain whu:Reagent ;
    rdfs:range <http://qudt.org/schema/qudt/QuantityValue> .

<http://qudt.org/schema/qudt/unit> a owl:ObjectProperty ;
    rdfs:label "unit"@en ;
    rdfs:domain whu:Indicator_definition ;
    rdfs:range <http://qudt.org/schema/qudt/Unit> .

<http://www.geonames.org/ontology#parentFeature> a owl:ObjectProperty ;
    rdfs:label "parentFeature"@en ;
    whu:prompt "its higher-level geographic or administrative region."@en ;
    rdfs:comment "its higher-level geographic or administrative region."@en,
        "其所属的更高层次地理或行政区域。"@zh ;
    rdfs:domain whu:EnvironmentFeature ;
    rdfs:range <http://www.geonames.org/ontology#Feature> .

skos:closeMatch a owl:ObjectProperty ;
    rdfs:label "closeMatch"@en ;
    whu:prompt "Align the specimen with the OBI-defined specimen concept for semantic integration."@en,
        "Align this processed specimen with OBI's processed material concept."@en,
        "Align with schema:SoftwareApplication class."@en,
        "Link to the closest OBI reagent class."@en,
        "Semantically aligned with OBI's material_processing class."@en,
        "Semantically aligned with OBI's specimen_collection_process class."@en,
        "Semantically aligned with standard ENVO environmental classifications."@en ;
    rdfs:comment "Semantically aligned with OBI reagent."@en,
        "Semantically aligned with OBI's definition of specimen, representing a material entity collected for investigation."@en,
        "Semantically aligned with OBI's processed material, indicating it results from a material processing step."@en,
        "Semantically aligned with standard ENVO environmental classifications."@en,
        "Semantically close to schema:SoftwareApplication."@en,
        "与 OBI 中的 processed material 概念语义对齐，表示其为处理流程的输出产物。"@zh,
        "在语义上与 OBI reagent 类接近。"@zh,
        "在语义上与 OBI 中 specimen 概念对齐，表示为研究采集的物质实体。"@zh,
        "在语义上与 schema.org 中的 SoftwareApplication 类对齐。"@zh,
        "在语义上与ENVO环境分类术语标准化对齐。"@zh,
        "在语义上与OBI中的material_processing子类对齐。"@zh,
        "在语义上与OBI中的采样类OBI_0000659（specimen_collection_process）对齐。"@zh ;
    rdfs:domain whu:EnvironmentFeature,
        whu:ProcessedSpecimen,
        whu:Reagent,
        whu:Software,
        whu:Specimen,
        whu:SpecimenCollection,
        whu:SpecimenPreprocessing ;
    rdfs:range <http://purl.obolibrary.org/obo/ENVO_00002297>,
        <http://purl.obolibrary.org/obo/obi#0000643>,
        <http://purl.obolibrary.org/obo/obi#0001479>,
        <http://purl.obolibrary.org/obo/obi#OBI_0000659>,
        <http://purl.obolibrary.org/obo/obi#OBI_0200000>,
        <http://purl.obolibrary.org/obo/obi#reagent>,
        schema:SoftwareApplication .

dcat:servesDataset a owl:ObjectProperty ;
    rdfs:label "servesDataset"@en ;
    rdfs:domain whu:DataSetService ;
    rdfs:range whu:DataSet .

prov:generated a owl:ObjectProperty ;
    rdfs:label "generated"@en ;
    whu:prompt "Identify the data set generated by this step."@en,
        "Identify the processed specimen generated by this step."@en ;
    rdfs:comment "This step produces DataSet."@en,
        "This step produces a processed specimen."@en,
        "This step produces data set"@en,
        "该步骤生成处理后的样本。"@zh,
        "该步骤生成数据。"@zh,
        "该步骤生成数据集。"@zh ;
    rdfs:domain whu:BioChemicalActivityStep,
        whu:ComputationalActivityStep ;
    rdfs:range whu:DataSet,
        whu:ProcessedSpecimen .

prov:used a owl:ObjectProperty ;
    rdfs:label "used"@en ;
    whu:prompt "Identify the DataSet involved in this step."@en,
        "Identify the Software involved in this step."@en,
        "Identify the device involved in this step."@en,
        "Identify the reagent involved in this step."@en,
        "Identify the specimen involved in this step."@en ;
    rdfs:comment "This step involves a DataSet."@en,
        "This step involves a Software."@en,
        "This step involves a device."@en,
        "This step involves a reagent."@en,
        "This step involves a specimen."@en,
        "该步骤涉及数据集。"@zh,
        "该步骤涉及样本。"@zh,
        "该步骤涉及设备。"@zh,
        "该步骤涉及试剂。"@zh ;
    rdfs:domain whu:BioChemicalActivityStep,
        whu:ComputationalActivityStep ;
    rdfs:range whu:DataSet,
        whu:Device,
        whu:ProcessedSpecimen,
        whu:Reagent,
        whu:Software .

prov:usedBy a owl:ObjectProperty ;
    rdfs:label "usedBy"@en ;
    rdfs:domain whu:DataSetService ;
    rdfs:range whu:ActivityStep .

prov:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:label "wasAssociatedWith"@en ;
    whu:prompt "This experiment consists of biological or chemical steps."@en,
        "This experiment is composed of computational steps involving software and data."@en,
        "the activity steps involved in the specimen collection plan."@en,
        "the activity steps involved in the specimen preprocessing plan."@en ;
    rdfs:comment "This experiment consists of biological or chemical steps."@en,
        "This experiment is composed of computational activity steps."@en,
        "the activity steps involved in the specimen collection plan."@en,
        "the activity steps involved in the specimen preprocessing plan."@en,
        "样本采集计划涉及的活动步骤。"@zh,
        "样本预处理计划涉及的活动步骤。"@zh,
        "这个实验由生物或化学步骤组成。"@zh,
        "这个实验由计算步骤组成。"@zh ;
    rdfs:domain whu:Computational_Experiment,
        whu:SpecimenCollection,
        whu:SpecimenPreprocessing,
        whu:bio_chemical_Experiment ;
    rdfs:range whu:BioChemicalActivityStep,
        whu:ComputationalActivityStep .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "wasDerivedFrom"@en ;
    whu:prompt "Extract or align environmental context from which the specimen is derived."@en,
        "Indicate the original specimen this processed specimen was derived from."@en ;
    rdfs:comment "Indicates that the specimen is derived from a specific environmental context, which may influence its characteristics."@en,
        "The processed specimen is derived from a collected specimen sample."@en,
        "表示该样本来源于特定的环境上下文，环境因素可能影响其性质。"@zh,
        "该处理标本来源于采集得到的 specimen 原始样本。"@zh ;
    rdfs:domain whu:ProcessedSpecimen,
        whu:Specimen ;
    rdfs:range whu:EnvironmentFeature,
        whu:Specimen .

prov:wasUsedBy a owl:ObjectProperty ;
    rdfs:label "wasUsedBy"@en ;
    whu:prompt "Identify activity steps that used this software."@en,
        "Identify which activity step used the device."@en,
        "Identify which activity step used the reagent."@en ;
    rdfs:comment "This device is used in one or more experimental steps."@en,
        "This reagent was used during an activity step."@en,
        "This software was used in one or more activity steps."@en,
        "该设备被用于一个或多个实验步骤。"@zh,
        "该试剂在某个活动步骤中被使用。"@zh,
        "该软件在实验活动中被使用。"@zh ;
    rdfs:domain whu:Device,
        whu:Reagent,
        whu:Software ;
    rdfs:range whu:ActivityStep,
        whu:ComputationalActivityStep .

schema:about a owl:ObjectProperty ;
    rdfs:label "about"@en ;
    rdfs:domain whu:DataSet ;
    rdfs:range whu:TargetObject .

schema:hasBrand a owl:ObjectProperty ;
    rdfs:label "hasBrand"@en ;
    whu:prompt "Extract the brand of the device."@en ;
    rdfs:comment "The brand or label under which the device was sold."@en,
        "设备销售的品牌信息。"@zh ;
    rdfs:domain whu:Device ;
    rdfs:range schema:Brand .

schema:hasManufacturer a owl:ObjectProperty ;
    rdfs:label "hasManufacturer"@en ;
    whu:prompt "Extract the manufacturer of the device."@en ;
    rdfs:comment "The organization that manufactured the device."@en,
        "生产该设备的机构。"@zh ;
    rdfs:domain whu:Device ;
    rdfs:range schema:Organization .

schema:rangeIncludes a owl:ObjectProperty ;
    rdfs:label "rangeIncludes"@en ;
    rdfs:domain whu:Indicator_definition ;
    rdfs:range schema:QuantitativeValue .

