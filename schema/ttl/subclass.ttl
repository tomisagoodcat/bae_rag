 
@prefix bfo: <http://purl.obolibrary.org/obo/BFO_> .
@prefix chebi: <http://purl.obolibrary.org/obo/CHEBI_> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix deo: <http://purl.org/spar/deo/> .
@prefix envo: <http://purl.obolibrary.org/obo/ENVO_> .
@prefix fabio: <http://purl.org/spar/fabio/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix gn: <http://www.geonames.org/ontology#> .
@prefix iao: <http://purl.obolibrary.org/obo/IAO_> .
@prefix mp: <http://purl.org/mp#> .
@prefix ncbitaxon: <http://purl.obolibrary.org/obo/NCBITaxon_> .
@prefix obi: <http://purl.obolibrary.org/obo/obi#> .
@prefix omath: <http://ontomathpro.org/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix p-plan: <http://purl.org/net/p-plan#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ro: <http://purl.obolibrary.org/obo/RO_> .
@prefix rrdfs: <> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix stato: <http://purl.obolibrary.org/obo/STATO_> .
@prefix uo: <http://purl.obolibrary.org/obo/UO_> .
@prefix whu: <http://example.org/whu#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

whu:EnvironmentFeature a owl:Class ;# 基本类，不可分解，实例通过skos与envo对应#
   
    # 明确继承于多重父类，体现其空间、环境、地理特征的集成角色
    rdfs:subClassOf prov:Location, geo:Feature, gn:Feature, envo:00002297 . # envo:EnvironmentFeature (ENVO标准术语)

whu:Specimen a owl:Class ;
    rdfs:label "Specimen"@en ;
  
    mp:statement xsd:string ;
    rdfs:subClassOf 
        ##################################################
        ### 属于语义科学的 Material 类型
        ##################################################
        mp:Material ,

        ##################################################
        ### 明确为 prov:Entity，用于因果关系建模
        ##################################################
        prov:Entity .


whu:ProcessedSpecimen a owl:Class ;
 
    rdfs:subClassOf 
        ##################################################
        ### 是一种物质材料实体
        ##################################################
        mp:Material ,

        ##################################################
        ### 是 prov:Entity，支持溯源关系建模
        ##################################################
        prov:Entity .

whu:SpecimenCollection a owl:Class ;
 
    rdfs:subClassOf p-plan:Plan .

whu:SpecimenPreprocessing a owl:Class ;
    rdfs:label "Specimen Preprocessing"@en ;
 
    rdfs:subClassOf p-plan:Plan .

whu:Device a owl:Class ;
    rdfs:label "Device"@en ;
 

    rdfs:subClassOf 
        mp:Material ,
        schema:Product ,
        prov:Entity .

whu:Software a owl:Class ;
    rdfs:label "Software"@en ;
 

    rdfs:subClassOf 
        mp:Material , 
        schema:SoftwareApplication ,
        prov:Entity .

whu:Reagent a owl:Class ;
    rdfs:label "Reagent"@en ;
    rdfs:comment "Chemical or biological reagent used in sample treatment or analysis."@en ;
    rdfs:comment "用于样本处理或分析的化学或生物试剂。"@zh ;

    rdfs:subClassOf 
        mp:Material , 
        schema:Product , 
        prov:Entity .
whu:BioChemicalActivityStep a owl:Class ;
    rdfs:label "Biochemical Activity Step"@en ;
    rdfs:comment "A subclass_of ActivityStep involving biochemical procedures that use reagents, devices, specimens and produce data and processed specimens."@en ;
    rdfs:subClassOf 
        whu:ActivityStep .
whu:ComputationalActivityStep a owl:Class ;
    rdfs:subClassOf whu:ActivityStep, obi:0200000 .

whu:DataSet a owl:Class ;
    rdfs:label "DataSet"@en ;
    mp:statement xsd:string ;
    rdfs:comment "A structured dataset used or generated in scientific activities, emphasizing data provenance, semantic targets, and hierarchical organization."@en ;
    rdfs:comment "科学活动中生成或使用的结构化数据集，强调数据溯源、语义目标及层次化组织。"@zh ;
    whu:prompt "A quantitative measurement or observation generated by experimental methods, representing a collection or dataset. Each data point supports or challenges a claim and is causally linked to a method or activity step. Examples include 'mercury concentration results', 'heavy metal analysis data', 'soil contamination measurements'. Context: Aggregate evidence units, generated by methods, used to support claims; composed of specific data items with values and units."@en ;
 
 

    rdfs:subClassOf mp:Data ;
    rdfs:subClassOf dcat:Dataset ;
    rdfs:subClassOf iao:IAO_0000100 ;
    rdfs:subClassOf prov:Entity .
whu:Goal a owl:Class ;
    rdfs:subClassOf prov:Entity.

whu:TargetObject a owl:Class ;
    mp:statement xsd:string ;
    rdfs:label "Target Object"@en ;
    rdfs:comment "An object of scientific interest or concern."@en ;
    rdfs:comment "科学研究的目标对象。"@zh ;
 
    rdfs:subClassOf prov:Entity . 

whu:Target_analyte a owl:Class ;
    mp:statement xsd:string ;
    rdfs:label "Target Analyte"@en ;
    rdfs:comment "A chemical analyte of scientific interest or concern."@en ;
    rdfs:comment "概念对应chebi:ChemicalEntity，明确为具体的物理分析对象。其通过iao:is_about关联到iao:measurement_datum，进而链接至whu:DataSet，形成了从目标实体到测量数值再到数据集的完整溯源链。"@zh ;
    rdfs:subClassOf whu:TargetObject ,
                    chebi:ChemicalEntity ,
                    bfo:0000040 .  # material_entity
whu:Target_Variable a owl:Class ;
    mp:statement xsd:string ;
    rdfs:label "Target Variable"@en ;
    rdfs:comment "A variable of scientific interest or concern."@en ;
    rdfs:comment "针对计算分析中的抽象变量（如 T-test p-value），定义为iao:Parameter及stato:DependentVariable的子类。这不仅精确表达了其统计语义，还能与stato:StatisticalMethod建立关联，实现“统计方法-统计变量-统计数据”的精确语义推理。"@zh ;
    whu:prompt "Identify the variable of the experiment."@en ;

    rdfs:subClassOf whu:TargetObject ,
                    iao:0000030      , # information content entity
                    iao:0000027 ,       # parameter
                    stato:0000039 ,     # dependent variable
                    bfo:0000031       # generically dependent continuant
         .

    whu:Indicator_definition a owl:Class ;
    mp:statement xsd:string ;
    rdfs:label "Indicator Definition"@en ;
    rdfs:comment "A definition of an indicator."@en ;
    rdfs:comment "指标定义。"@zh ;
    whu:prompt "Identify the definition of the indicator."@en ;
    rdfs:subClassOf iao:0000424 ,       # definition
                    prov:Entity .
    

    whu:bio_chemical_Experiment a owl:Class ;
    rdfs:subClassOf whu:Experiment .
whu:Computational_Experiment a owl:Class ;
    rdfs:subClassOf whu:Experiment .
whu:Method a owl:Class ;
    rdfs:subClassOf p-plan:Plan, mp:Method, obi:0000272 .