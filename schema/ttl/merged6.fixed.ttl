@prefix ns1: <http://example.org/whu#> .
@prefix ns2: <http://www.w3.org/2002/07/owl#> .
@prefix ns3: <http://purl.org/mp#> .
@prefix ns4: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:Computational_Experiment a ns2:Class ;
    rdfs:label "Computational Experiment"@en ;
    ns1:prompt "Identify computational experiments involving data transformation or analysis steps using software."@en ;
    rdfs:comment "A computational experiment involves the use of software and computational procedures to process or analyze data."@en ;
    rdfs:subClassOf [ a ns2:Restriction ;
            ns1:prompt "This experiment is composed of computational steps involving software and data."@en ;
            rdfs:comment "This experiment is composed of computational activity steps."@en ;
            ns2:onProperty <http://www.w3.org/ns/prov#wasAssociatedWith> ;
            ns2:someValuesFrom ns1:ComputationalActivityStep ] ;
    ns4:closeMatch <http://purl.obolibrary.org/obo/obi#OBI_0600046> .

ns1:DataSetService a ns2:Class ;
    rdfs:label "DataService"@en ;
    ns1:prompt "Identify external dynamic data services, their served datasets, and endpoint URLs."@en,
        "识别外部动态数据服务，所提供的数据集及服务端点。"@zh ;
    ns3:statement xsd:string ;
    rdfs:comment "A dynamic service providing datasets through an endpoint URL, used in scientific research."@en ;
    rdfs:subClassOf [ a ns2:Restriction ;
            ns2:onProperty <http://www.w3.org/ns/prov#usedBy> ;
            ns2:someValuesFrom ns1:ActivityStep ],
        [ a ns2:Restriction ;
            ns2:onProperty <http://www.w3.org/ns/dcat#servesDataset> ;
            ns2:someValuesFrom ns1:DataSet ],
        [ a ns2:Restriction ;
            ns2:onProperty <http://www.w3.org/ns/dcat#endpointURL> ;
            ns2:someValuesFrom xsd:anyURI ],
        ns3:Data,
        <http://www.w3.org/ns/dcat#DataService> .

ns1:DataSetSupportClaim a ns2:ObjectProperty ;
    rdfs:label "Data supports Claim"@en ;
    ns1:prompt "Identify the scientific claim supported by the data."@en ;
    ns3:statement xsd:string ;
    rdfs:comment "Data supports a scientific claim."@en ;
    rdfs:domain ns1:DataSet ;
    rdfs:range ns3:Claim ;
    rdfs:subPropertyOf ns3:dataSupports .

ns1:DataSetSupportStatement a ns2:ObjectProperty ;
    rdfs:label "Data supports Statement"@en ;
    ns1:prompt "Identify the scientific statement supported by the data."@en ;
    ns3:statement xsd:string ;
    rdfs:domain ns3:DataSet ;
    rdfs:range ns3:Statement ;
    rdfs:subPropertyOf ns3:dataSupports .

ns1:DataSetchallengeClaim a ns2:ObjectProperty ;
    rdfs:label "challenge Claim"@en ;
    ns1:prompt "Identify the scientific claim challenged by the dataset."@en ;
    ns3:statement xsd:string ;
    rdfs:domain ns1:DataSet ;
    rdfs:range ns3:Claim ;
    rdfs:subPropertyOf ns3:challenge .

ns1:DataSetchallengeStatement a ns2:ObjectProperty ;
    rdfs:label "challenge statement"@en ;
    ns1:prompt "Identify the scientific statement challenged by the dataset."@en ;
    ns3:statement xsd:string ;
    rdfs:comment "Dataset challenge a scientific statement."@en ;
    rdfs:domain ns1:DataSet ;
    rdfs:range ns3:Statement ;
    rdfs:subPropertyOf ns3:challenge .

ns1:Indicator a ns2:Class ;
    rdfs:label "Indicator"@en ;
    ns1:prompt "Identify the indicator of the experiment."@en ;
    ns3:statement xsd:string ;
    rdfs:comment "A measurable property or quantity of interest."@en ;
    rdfs:subClassOf [ a ns2:Restriction ;
            ns2:onProperty <http://purl.obolibrary.org/obo/IAO_is_denoted_by> ;
            ns2:someValuesFrom ns1:Indicator_definition ],
        ns1:Target_Variable .

ns1:MethodsupportsData a ns2:ObjectProperty ;
    rdfs:label "Methodsupports Data"@en ;
    ns1:prompt "Identify the data supported by a method."@en ;
    ns3:statement xsd:string ;
    rdfs:comment "A method supports a data."@en ;
    rdfs:domain ns3:Method ;
    rdfs:range ns3:Data ;
    rdfs:subPropertyOf ns3:methodSupports .

ns1:computational_Experiment a ns2:Class ;
    rdfs:label "computational Experiment"@en ;
    ns1:prompt "Extract information about 'computational Experiment' from the scientific text."@en ;
    rdfs:comment "computational_Experiment is an ontology class placeholder requiring proper definition."@en .

<http://purl.obolibrary.org/obo/IAO_data_item> a ns2:Class ;
    rdfs:label "http://purl.obolibrary.org/obo/IAO data item"@en ;
    ns1:prompt "Extract information about 'http://purl.obolibrary.org/obo/IAO data item' from the scientific text."@en ;
    rdfs:comment "http://purl.obolibrary.org/obo/IAO_data_item is an ontology class placeholder requiring proper definition."@en .

ns3:Attribution a ns2:Class ;
    rdfs:subClassOf ns3:Representation .

